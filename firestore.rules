rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidBackup(data) {
      return data.keys().hasAll(['userId', 'stateJson', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'stateJson', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.stateJson is string && data.stateJson.size() <= 500000
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /backups/{backupId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(backupId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(backupId) && isValidBackup(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(backupId) && isValidBackup(request.resource.data)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(backupId);
      }
    }
  }
}
