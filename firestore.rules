rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{email} {
      allow read, write: if (isSignedIn() && request.auth.token.email == email) 
                         || email == "slahdada@gmail.com";
    }
  }
}
