{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and private carnet state document",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Auth user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name or display name"
        },
        "stateJson": {
          "type": "string",
          "description": "Serialized carnet state JSON"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last synchronization timestamp"
        }
      },
      "required": ["userId", "email", "stateJson", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User private carnet document strictly accessible only by the owning authenticated user"
    }
  }
}
