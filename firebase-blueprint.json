{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User real-time carnet state sync document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "stateJson": {
          "type": "string",
          "description": "Serialized carnet state JSON"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last synchronization timestamp"
        }
      },
      "required": ["email", "stateJson", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{email}": {
      "schema": "UserProfile",
      "description": "User carnet document"
    }
  }
}
